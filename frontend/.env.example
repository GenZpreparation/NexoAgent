# ---------------------------------------------------------------------------
# NexoAgent frontend environment. Copy to `.env.local` and adjust.
# Never put secrets here: every NEXT_PUBLIC_* value is shipped to the browser.
# ---------------------------------------------------------------------------

# Data source for the UI:
#   mock -> in-browser demo data (default, no backend needed, clearly labelled "Demo data")
#   api  -> real FastAPI backend through the /api/v1 proxy (requires sign-in)
NEXT_PUBLIC_DATA_MODE=mock

# Where the Next.js server proxies /api/v1/* requests (server-side only, not exposed).
BACKEND_ORIGIN=http://127.0.0.1:8000

# Base path the browser uses for API calls. Leave as /api/v1 to use the proxy above.
# Only set an absolute URL if the backend enables CORS for this origin.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Mock mode is blocked in production builds unless explicitly allowed (e.g. a public demo).
NEXT_PUBLIC_ALLOW_MOCK_IN_PRODUCTION=false
